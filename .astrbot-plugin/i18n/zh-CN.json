  "config": {
    "stratz_api_token": {
      "description": "STRATZ API Token（必填）",
      "hint": "stratz.com 的 API TOKEN，可在 https://stratz.com/api 获取。未配置时无法查询，后台追踪不会启动。"
    },
    "data_parsing_timeout_minutes": {
      "description": "等待比赛解析的时间（分钟）",
      "hint": "超过等待时间仍未解析时直接生成战报。范围 0–1440。"
    },
    "proxy_address": {
      "description": "代理地址",
      "hint": "如 http://127.0.0.1:7890 或 socks5://host:port，不使用代理请留空。"
    },
    "suppress_api_network_errors": {
      "description": "网络错误降级为 debug 日志",
      "hint": "开启后 Stratz/OpenDota 的超时、断网等网络错误以 debug 级别输出（403 除外）。"
    },
    "enable_opendota_fallback": {
      "description": "启用 OpenDota 备用数据源",
      "hint": "Stratz 无可用结果时使用 OpenDota 作为战报追踪与查询比赛的备用数据源。"
    },
    "opendota_api_key": {
      "description": "OpenDota API Key",
      "hint": "OpenDota 付费订阅 API Key，免费用户请留空。"
    },
    "opendota_ip_stack": {
      "description": "OpenDota IP 协议栈",
      "hint": "访问 OpenDota 频繁失败时可强制使用 IPv4（配置代理时忽略）。",
      "labels": [
        "自动",
        "强制 IPv4"
      ]
    },
    "default_locale": {
      "description": "默认语言",
      "hint": "频道未单独设置语言时使用的运行时语言。",
      "labels": [
        "简体中文",
        "English"
      ]
    },
    "use_hero_nicknames": {
      "description": "使用英雄别名",
      "hint": "关闭后仅使用英雄正式名称。"
    },
    "url_in_message_type": {
      "description": "消息中附带链接",
      "hint": "可填写 match（比赛/战报附带 Stratz 比赛链接）、player（玩家附带 Stratz 玩家链接）、hero（英雄附带刀塔百科链接）。",
      "labels": [
        "比赛",
        "玩家",
        "英雄"
      ]
    },
    "max_send_item_count": {
      "description": "最大发送物品图片数量",
      "hint": "查询物品结果超过该数量时由下一项决定是否发送物品列表图片。范围 1–10。"
    },
    "show_item_list_at_too_much_items": {
      "description": "物品过多时发送物品列表",
      "hint": "查询结果超过最大数量时发送匹配物品列表图片。"
    },
    "custom_item_alias": {
      "description": "额外物品别名",
      "hint": "内置别名列表没有的物品别名可在此追加，例如 关键词：闪烁匕首，别名：跳刀。",
