{#- Port of old/src/templates/item/itemlist.ejs. Font sizes come from presentation/viewmodels/item.py. -#}
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <style>
      * { margin: 0; padding: 0; }
      html, body { height: auto; background-color: #000; color: #fff; }
      html { width: 232px; }
      body { width: 220px; margin: 6px; }
      .container {
        width: 220px;
        display: flex;
        flex-wrap: wrap;
        justify-content: space-between;
        align-items: center;
        row-gap: 8px;
      }
      .container img { width: 44px; height: 32px; }
      .container .item {
        width: 48px;
        height: 54px;
        display: flex;
        flex-direction: column;
        font-size: 12px;
        align-items: center;
        justify-content: space-around;
      }
      .name {
        overflow: hidden;
        text-overflow: ellipsis;
        text-align: center;
        line-height: 1.2;
        min-height: 12px;
      }
    </style>
  </head>
  <body>
    <div class="container">
      {% for item in items %}
        <div class="item" id="{{ item.id | js }}">
          <img src="{{ item.img }}" />
          <div class="name" style="font-size: {{ item.fontSize }}px">
            {{ item.nameLoc | js }}
          </div>
        </div>
      {% endfor %}
    </div>
  </body>
</html>
