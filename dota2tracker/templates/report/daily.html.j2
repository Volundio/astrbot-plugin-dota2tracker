{#- Port of old/src/templates/report/daily.ejs (+ daily/spotlight_card.ejs, daily/style.css).
    Values come from presentation/viewmodels/report.py (build_daily_view). -#}
<!DOCTYPE html>
<html class="dark" lang="en">
  <head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <title>Dota 2 Daily Recap</title>
    <style>
    {{ css("report/daily/style.css") }}
    </style>
    <style>
      ::-webkit-scrollbar { width: 8px; }
      ::-webkit-scrollbar-track { background: #101922; }
      ::-webkit-scrollbar-thumb { background: #233648; border-radius: 4px; }
      ::-webkit-scrollbar-thumb:hover { background: #137fec; }
      .bg-texture {
        background-color: #101922;
        background-image:
          radial-gradient(at 0% 0%, rgba(19, 127, 236, 0.08) 0px, transparent 50%), radial-gradient(at 100% 0%, rgba(255, 60, 60, 0.05) 0px, transparent 50%), radial-gradient(at 100% 100%, rgba(232, 188, 86, 0.05) 0px, transparent 50%);
      }
      .truncate {
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
      }
      .shrink-0 {
        flex-shrink: 0;
      }
      .min-w-0 {
        min-width: 0;
      }
      .whitespace-nowrap {
        white-space: nowrap;
      }
    </style>
  </head>
  <body class="bg-texture font-display text-white overflow-x-hidden antialiased min-h-screen w-[1024px] min-w-[1000px]">
    <div class="w-full flex justify-center py-8 px-4 sm:px-6">
      <div class="w-full max-w-[900px] flex flex-col gap-8">

        <div class="flex flex-col items-center justify-center pt-2 pb-4 text-center">
          <div class="mb-3 border-b-2 border-dota-red pb-1">
            <span class="text-xs font-bold tracking-[0.2em] uppercase text-dota-gold drop-shadow-md">
              {{ t("dota2tracker.template.report.daily.plugin_name") }}
            </span>
          </div>
          <h1 class="text-4xl md:text-6xl font-serif font-black tracking-tight text-white uppercase drop-shadow-[0_2px_10px_rgba(0,0,0,0.5)] mb-2">
            {{ t("dota2tracker.template.report.daily.title") }}
          </h1>
          <div class="flex flex-col items-center gap-1 text-slate-400 font-medium">
            <p class="text-lg tracking-widest uppercase text-slate-300">{{ meta.date | js }}</p>
            <p class="text-xs opacity-60 max-w-md mx-auto">
              {{ meta.summary | js }}
            </p>
          </div>
        </div>

        <div class="grid grid-cols-2 md:grid-cols-4 gap-3">
          <div class="flex flex-col items-center justify-center p-4 rounded bg-card-dark border border-white/5 shadow-lg relative overflow-hidden group">
            <span class="text-slate-500 text-[10px] font-bold uppercase tracking-widest mb-1">
              {{ t("dota2tracker.template.report.daily.stats.matches") }}
            </span>
            <span class="text-3xl font-black text-white">{{ headerStats.matches.value | js }}</span>
            <span class="text-xs text-slate-400 mt-1">{{ headerStats.matches.subtext | js }}</span>
          </div>

          <div class="flex flex-col items-center justify-center p-4 rounded bg-card-dark border border-white/5 shadow-lg relative overflow-hidden group">
            <div class="absolute inset-x-0 bottom-0 h-1 {{ winRateBarClass }}"></div>
            <span class="text-slate-500 text-[10px] font-bold uppercase tracking-widest mb-1">
              {{ t("dota2tracker.template.report.daily.stats.win_rate") }}
            </span>
            <span class="text-3xl font-black {{ winRateClass }}">{{ headerStats.winRate.value | js }}</span>
            <span class="text-xs mt-1 {{ winRateSubtextClass }}">{{ headerStats.winRate.subtext | js }}</span>
          </div>

          <div class="flex flex-col items-center justify-center p-4 rounded bg-card-dark border border-white/5 shadow-lg relative overflow-hidden group">
            <div class="absolute inset-x-0 bottom-0 h-1 bg-dota-red/50"></div>
            <span class="text-slate-500 text-[10px] font-bold uppercase tracking-widest mb-1">
              {{ t("dota2tracker.template.report.daily.stats.kills") }}
            </span>
            <span class="text-3xl font-black text-dota-red">{{ headerStats.kills.value | js }}</span>
            <span class="text-xs text-slate-400 mt-1">{{ headerStats.kills.subtext | js }}</span>
          </div>

          <div class="flex flex-col items-center justify-center p-4 rounded bg-card-dark border border-white/5 shadow-lg relative overflow-hidden group">
            <div class="absolute inset-x-0 bottom-0 h-1 bg-dota-gold/50"></div>
            <span class="text-slate-500 text-[10px] font-bold uppercase tracking-widest mb-1">
              {{ t("dota2tracker.template.report.daily.stats.duration") }}
            </span>
            <span class="text-3xl font-black text-dota-gold">{{ headerStats.duration.value | js }}</span>
            <span class="text-xs text-slate-400 mt-1">
              {{ headerStats.duration.subtext | js }}
            </span>
          </div>
        </div>

        <div class="flex flex-col gap-3 mt-2">
          {% for card in cards %}
<div class="flex items-center gap-0 flex-1">
  <div class="shrink-0 flex items-center justify-center">
    <svg xmlns="http://www.w3.org/2000/svg" class="w-10 h-10 fill-current {{ card.accentTextColor }}" viewBox="0 0 24 24">
      {% if card.icon == "trophy" %}
        <path d="M19 5h-2V3H7v2H5c-1.1 0-2 .9-2 2v1c0 2.55 1.92 4.63 4.39 4.94.63 1.5 1.98 2.63 3.61 2.96V19H7v2h10v-2h-4v-3.1c1.63-.33 2.98-1.46 3.61-2.96C19.08 12.63 21 10.55 21 8V7c0-1.1-.9-2-2-2zM5 8V7h2v3.82C5.84 10.4 5 9.3 5 8zm14 0c0 1.3-.84 2.4-2 2.82V7h2v1z"/>
      {% elif card.icon == "warning" %}
        <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-2h2v2zm0-4h-2V7h2v6z"/>
      {% elif card.icon == "shield" %}
        <path d="M12 2L4 5v6.09c0 5.05 3.41 9.76 8 10.91 4.59-1.15 8-5.86 8-10.91V5l-8-3zm1 12h-2v-2H9v-2h2V8h2v2h2v2h-2v2z"/>
      {% elif card.icon == "heart" %}
        <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z M13 7h-2v3H8v2h3v3h2v-3h3v-2h-3V7z"/>
      {% elif card.icon == "hammer" %}
        <path d="M22.7 19l-9.1-9.1c.9-2.3.4-5-1.5-6.9-2-2-5-2.4-7.4-1.3L9 6 6 9 1.6 4.7C.4 7.1.9 10.1 2.9 12.1c1.9 1.9 4.6 2.4 6.9 1.5l9.1 9.1c.4.4 1 .4 1.4 0l2.3-2.3c.5-.4.5-1.1.1-1.4z"/>
      {% else %}
        <path d="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm-2 10H7v-2h10v2z"/>
      {% endif %}
    </svg>
  </div>
  <div class="grid grid-cols-[auto_auto_1fr_auto_1fr_auto] items-center flex-1 relative rounded-lg border {{ card.borderStyle }} bg-card-dark overflow-hidden group ">
    <div class="{{ card.badgeStyle }} w-25 px-4 self-stretch flex justify-center items-center text-sm font-black uppercase shadow-lg"> {{ card.title | js }} </div>
    <img class="w-auto h-9 object-cover rounded-2 ml-3" src="{{ card.player.heroBannerUrl | js }}">
    <h3 class="pl-4 font-serif font-bold text-white drop-shadow-md text-base leading-tight truncate">{{ card.player.name | js }}</h3>
    <p class="flex w-38 justify-center text-slate-400 text-sm font-mono whitespace-nowrap">{{ card.player.kda | js }}</p>
    <div class="flex flex-wrap items-center gap-x-2 gap-y-1.5 py-2.5 pr-4">
      {% for badge in card.badges %}
        <span class="inline-flex items-center justify-center shrink-0 px-2 py-0.5 rounded text-[11px] font-bold uppercase border whitespace-nowrap" style="{{ badge.style }}">{{ badge.text | js }}</span>
      {% endfor %}
    </div>
    <div class="flex justify-between items-center min-w-44 pr-3 pl-2">
      <span class="text-xs text-slate-400 uppercase tracking-widest font-bold w-15"> {{ card.score.label | js }} </span>
      <span class="font-mono text-2xl font-bold {{ card.accentTextColor }}">{{ card.score.value | js }}</span>
    </div>
  </div>
</div>
          {% endfor %}
        </div>

        <div class="bg-[#0d141c] rounded-xl border border-white/5 overflow-hidden">
          <div class="flex items-center justify-between p-4 border-b border-white/5 bg-[#16202c]">
            <h2 class="text-lg font-serif font-bold text-white uppercase tracking-wider flex items-center gap-2">
              <span class="w-1 h-4 bg-dota-red rounded-full"></span>
              {{ t("dota2tracker.template.report.daily.squad.title") }}
            </h2>
            <div class="text-[10px] font-bold text-slate-400 uppercase tracking-widest bg-black/20 px-2 py-1 rounded border border-white/5">
              {{ t("dota2tracker.template.report.daily.squad.subtitle") }}
            </div>
          </div>

          <div class="hidden md:grid grid-cols-12 gap-4 px-4 py-3 text-[10px] font-bold text-slate-500 uppercase tracking-widest bg-black/20">
            <div class="col-span-1 text-center">{{ t("dota2tracker.template.report.daily.squad.header.rank") }}</div>
            <div class="col-span-3 pl-2">{{ t("dota2tracker.template.report.daily.squad.header.player_info") }}</div>
            <div class="col-span-3">{{ t("dota2tracker.template.report.daily.squad.header.hero_pool") }}</div>
            <div class="col-span-2 text-center">{{ t("dota2tracker.template.report.daily.squad.header.kda") }}</div>
            <div class="col-span-1 text-center">{{ t("dota2tracker.template.report.daily.squad.header.score") }}</div>
            <div class="col-span-2 text-left pl-2">{{ t("dota2tracker.template.report.daily.squad.header.impact") }}</div>
          </div>

          <div class="flex flex-col">
            {% for row in squad %}
            <div class="flex flex-col md:grid md:grid-cols-12 gap-4 p-4 border-b border-white/5 hover:bg-white/[0.02] transition-colors items-center">
              <div class="col-span-1 flex items-center justify-center">
                <span class="font-serif italic text-2xl {{ row.rankClass }} font-bold">{{ row.rank | js }}</span>
              </div>
              <div class="col-span-3 w-full flex items-center gap-3 pl-2 min-w-0">
                <div class="w-11 h-11 shrink-0 rounded bg-cover bg-center border border-slate-600 shadow-md" style="background-image: url('{{ row.player.avatarUrl or '' }}')"></div>
                <div class="flex flex-col min-w-0">
                  <span class="font-bold text-white text-base leading-tight truncate">{{ row.player.name | js }}</span>
                  <div class="flex items-center gap-1 text-xs font-medium mt-0.5 whitespace-nowrap">
                    <span class="text-dota-green">{{ row.player.winCount | js }} {{ t("dota2tracker.template.won") }}</span>
                    <span class="text-slate-500">-</span>
                    <span class="text-dota-red">{{ row.player.loseCount | js }} {{ t("dota2tracker.template.lost") }}</span>
                  </div>
                </div>
              </div>
              <div class="col-span-3 w-full flex items-center gap-2">
                {% for hero in row.heroes %}
                  <div class="relative w-[48px] h-[27px] rounded border border-slate-700 shadow-sm overflow-hidden group shrink-0">
                    <div class="absolute inset-0 bg-cover bg-center" style="background-image: url('{{ hero.url | js }}')"></div>
                    <div class="absolute inset-x-0 bottom-0 flex justify-between px-1 pb-0.5 pointer-events-none">
                      <span class="text-[10px] font-bold leading-none text-dota-green drop-shadow-[0_1px_2px_rgba(0,0,0,0.8)]" style="text-shadow: -1px -1px 0 #000, 1px -1px 0 #000, -1px 1px 0 #000, 1px 1px 0 #000;">{{ hero.wins | js }}</span>
                      <span class="text-[10px] font-bold leading-none text-dota-red drop-shadow-[0_1px_2px_rgba(0,0,0,0.8)]" style="text-shadow: -1px -1px 0 #000, 1px -1px 0 #000, -1px 1px 0 #000, 1px 1px 0 #000;">{{ hero.losses | js }}</span>
                    </div>
                  </div>
                {% endfor %}
                {% if row.plusHeroesCount > 0 %}
                  <span class="text-[10px] font-bold bg-slate-800 text-slate-400 px-1.5 py-0.5 rounded border border-slate-700 shrink-0">+{{ row.plusHeroesCount | js }}</span>
                {% endif %}
              </div>
              <div class="col-span-2 w-full flex flex-col items-center justify-center">
                <span class="text-xl font-bold text-white leading-none">{{ row.kda.ratio | js }}</span>
                <div class="text-[10px] text-slate-400 font-mono tracking-tight mt-1 whitespace-nowrap">{{ row.kda.detail | js }}</div>
              </div>
              <div class="col-span-1 w-full flex flex-col items-center justify-center">
                <span class="text-xl font-bold font-mono text-dota-gold leading-none">{{ row.mvpScore | js }}</span>
              </div>
              <div class="col-span-2 w-full flex flex-col justify-center gap-1.5 pl-2">
                <div class="flex items-center gap-2 w-full">
                  <span class="text-[9px] w-6 text-slate-500 font-bold uppercase">
                    {{ t("dota2tracker.template.report.daily.squad.impact.dmg") }}
                  </span>
                  <div class="flex-1 h-1.5 bg-slate-800 rounded-full overflow-hidden flex">
                    <div class="h-full bg-dota-red" style="width: {{ row.impact.damage.heroPercent | js }}%"></div>
                    <div class="h-full bg-orange-500" style="width: {{ row.impact.damage.buildingsPercent | js }}%"></div>
                  </div>
                </div>
                <div class="flex items-center gap-2 w-full">
                  <span class="text-[9px] w-6 text-slate-500 font-bold uppercase">
                    {{ t("dota2tracker.template.report.daily.squad.impact.gold") }}
                  </span>
                  <div class="flex-1 h-1.5 bg-slate-800 rounded-full overflow-hidden">
                    <div class="h-full bg-dota-gold" style="width: {{ row.impact.networth.percent | js }}%"></div>
                  </div>
                </div>
              </div>
            </div>
            {% endfor %}

            </div>
        </div>

        <div class="flex flex-col items-center justify-center text-center gap-1 pb-6 opacity-60">
          <div class="flex items-center gap-2 text-dota-gold text-xs font-bold uppercase tracking-widest" style="display: none;">
            <span class="material-symbols-outlined text-sm">auto_awesome</span>
            <span>{{ t("dota2tracker.template.report.daily.footer.generated_by") }}</span>
          </div>
          <p class="text-[10px] text-slate-500 font-mono">{{ meta.footerId | js }}</p>
        </div>
      </div>
    </div>
  </body>
</html>
