{#- Port of old/src/templates/match/match_2+/lane_outcome.ejs; lane pairs come from view["lanes"]. -#}
{% macro level_ring(lvl) -%}
<svg width="32" height="32" viewBox="0 0 32 32">
            <circle cx="16" cy="16" r="12" fill="none" stroke="#eee" stroke-width="2"/>
            <circle cx="16" cy="16" r="12" fill="none" stroke="#ffd700" stroke-width="2"
                    stroke-dasharray="{{ lvl.prog }} {{ lvl.gap }}"
                    stroke-linecap="round" transform="rotate(-90 16 16)"/>
            <text x="16" y="16" text-anchor="middle" dominant-baseline="middle" fill="#333" font-size="10" font-weight="bold">{{ lvl.lvl | js }}</text>
          </svg>
{%- endmacro %}
<div class="lane_outcome">
  {% if odParsed %}
  <p class="subtitle">{{ t("dota2tracker.template.opendota.lane_outcome_tip") }}</p>
  {% endif %}

  <div class="panel">
    {% for lane in lanes %}
    <div class="lane">
      {% for d in lane.pairs %}
        <div class="details">
          <img src="{{ d.p1.icon }}" class="hero radiant" />

          {{ level_ring(d.p1.lvl) }}

          <p class="kda">{{ d.p1.k | js }}/{{ d.p1.d | js }}/{{ d.p1.a | js }}</p>

          <div class="graph">
            <svg width="240" height="32" viewBox="0 0 240 32">
              <g transform="translate(0,0)">
                <rect y="9" width="240" height="14" fill="#9c3628"/>
                <rect y="9" width="{{ d.gold.splitWidth }}" height="14" fill="#3c9028"/>
                <line x1="{{ d.gold.splitWidth }}" y1="9" x2="{{ d.gold.splitWidth }}" y2="25" stroke="#fff" stroke-width="1"/>

                <text x="5" y="50%" dominant-baseline="middle" fill="#fff" font-size="10" text-anchor="start">
                  {{ "~" if d.gold.isOd else "" }}{{ d.gold.g1 }}
                </text>
                <text x="235" y="50%" dominant-baseline="middle" fill="#fff" font-size="10" text-anchor="end">
                  {{ "~" if d.gold.isOd else "" }}{{ d.gold.g2 }}
                </text>
                <text x="{{ d.gold.splitWidth }}" y="5px" dominant-baseline="middle" fill="{{ d.gold.diffColor }}" font-size="10" text-anchor="middle">
                  +{{ d.gold.diff }}
                </text>
              </g>
            </svg>
          </div>

          <p class="kda">{{ d.p2.k | js }}/{{ d.p2.d | js }}/{{ d.p2.a | js }}</p>

          {{ level_ring(d.p2.lvl) }}

          <img src="{{ d.p2.icon }}" class="hero dire" />
        </div>
      {% endfor %}
    </div>
    {% endfor %}
  </div>
</div>
